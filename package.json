{
  "name": "kult-konnect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/prepare-ota.mjs",
    "preview": "vite preview --host",
    "serve": "vite preview --host",
    "serve:apk": "node scripts/serve-apk.mjs",
    "build:apk": "npm run build && npx cap sync android && (cd android && JAVA_HOME=\"/Applications/Android Studio.app/Contents/jbr/Contents/Home\" ./gradlew assembleRelease) && cp android/app/build/outputs/apk/release/app-release.apk public/kult-konnect.apk && cp android/app/build/outputs/apk/release/app-release.apk dist/kult-konnect.apk",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npx cap sync android",
    "cap:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-health": "^8.11.11",
    "@capgo/capacitor-updater": "^8.53.0",
    "chart.js": "^4.4.6",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.3"
  }
}
